{
  "name": "pet-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Micro-frontend internal store application with Vue and React",
  "scripts": {
    "dev:host": "pnpm --filter @pet-store/host dev",
    "dev:catalog": "pnpm --filter @pet-store/mf-catalog dev",
    "dev:cart": "pnpm --filter @pet-store/mf-cart dev",
    "dev:all": "pnpm -r --parallel -r dev",
    "build": "pnpm -r build",
    "build:host": "pnpm --filter @pet-store/host build",
    "build:catalog": "pnpm --filter @pet-store/mf-catalog build",
    "build:cart": "pnpm --filter @pet-store/mf-cart build",
    "preview": "pnpm --filter @pet-store/host preview",
    "preview:catalog": "pnpm --filter @pet-store/mf-catalog preview",
    "preview:cart": "pnpm --filter @pet-store/mf-cart preview",
    "preview:all": "pnpm -r --parallel preview",
    "lint": "eslint . --ext .ts,.tsx,.vue",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
